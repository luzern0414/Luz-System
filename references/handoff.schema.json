          "title": {
            "type": "string",
            "minLength": 1
          },
          "route": {
            "type": "string",
            "minLength": 1
          },
          "roleIds": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "flowIds": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "purpose": {
            "type": "string",
            "minLength": 1
          },
          "states": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "enum": [
                "loading",
                "empty",
                "partial",
                "error",
                "offline",
                "timeout",
                "permission",
                "expired",
                "unavailable",
