{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://luz.local/schemas/design-handoff.schema.json",
  "title": "Luz design-to-development handoff",
  "description": "Stable, implementation-ready contract produced by Luz Design and consumed by Luz Dev.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "project",
    "surfaces",
    "roles",
    "designSystem",
    "flows",
    "screens",
    "components",
    "assets",
    "apiIntents",
    "acceptance"
  ],
  "properties": {
    "schemaVersion": {
      "const": "1.0"
    },
    "project": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "summary",
        "audience",
        "outcome",
        "goals",
        "nonGoals",
        "assumptions",
        "sources"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9-]*$"
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "summary": {
          "type": "string",
          "minLength": 1
        },
        "audience": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "outcome": {
          "type": "string",
          "minLength": 1
        },
        "goals": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "nonGoals": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "assumptions": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "sources": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "surfaces": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "enum": [
          "mini-program",
          "admin",
          "mobile-app"
        ]
      }
    },
    "roles": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "name",
          "description"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]*$"
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "description": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "designSystem": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "positioning",
        "tokenSources",
        "componentLibrary",
        "accessibility"
      ],
      "properties": {
        "positioning": {
          "type": "string",
          "minLength": 1
        },
        "tokenSources": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "componentLibrary": {
          "type": "string",
          "minLength": 1
        },
        "accessibility": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "contrastEvidence",
            "keyboardOrTouchEvidence",
            "reducedMotion",
            "contentScaling"
